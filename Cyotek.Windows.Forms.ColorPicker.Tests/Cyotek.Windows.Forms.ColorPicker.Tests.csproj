<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- NUnit 4.x supports .NET Framework 4.6.2+ and .NET 6.0+ only -->
		<TargetFrameworks>net462;net47;net471;net472;net48;net481;net8.0-windows;net9.0-windows;net10.0-windows;net11.0-windows</TargetFrameworks>
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>

	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<RootNamespace>Cyotek.Windows.Forms.ColorPicker.Tests</RootNamespace>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	</PropertyGroup>

	<PropertyGroup>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>..\res\Cyotek.Windows.Forms.ColorPicker.snk</AssemblyOriginatorKeyFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\res\Cyotek.Windows.Forms.ColorPicker.snk" Link="Cyotek.Windows.Forms.ColorPicker.snk" />
	</ItemGroup>

	<PropertyGroup>
		<!-- Temporary -->
		<NoWarn>1701;1702;612;618;CA1416</NoWarn>
		<!-- Allow Test.Sdk to run on older TFMs (net5.0-windows, net6.0-windows, net7.0-windows, netcoreapp3.1) -->
		<SuppressTfmSupportBuildErrors>true</SuppressTfmSupportBuildErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="NUnit" Version="4.4.0" />
		<PackageReference Include="NUnit3TestAdapter" Version="6.1.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
	</ItemGroup>

	<ItemGroup>
